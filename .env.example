# Environment
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Database (required — server refuses to boot without it)
DATABASE_URL=postgresql://user:password@localhost:5432/thrivo

# Redis (required — backs caching and the BullMQ job queue)
REDIS_URL=redis://localhost:6379

# Auth (required — signs access JWTs + legacy BetterAuth session; min 32 chars)
BETTER_AUTH_SECRET=your-secret-key-min-32-characters-long-please
# Hand-rolled auth token lifetimes (optional — sane defaults shown)
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# Deep link the OAuth callback returns to with the issued tokens (app parses it)
APP_AUTH_REDIRECT_URL=thrivo://auth
# Public base URL of the API. The Google OAuth redirect URI is derived from this
# as <AUTH_BASE_URL>/api/v1/auth/google/callback — register THAT in the Google
# console. Prod: https://api.thrivo.fit
AUTH_BASE_URL=http://localhost:4000
# CORS allowlist (comma-separated first-party origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Origins BetterAuth accepts as a post-OAuth callbackURL (web/admin + mobile app
# scheme). AUTH_BASE_URL is always trusted and need not be listed. In prod:
# https://thrivo.fit,https://www.thrivo.fit,thrivo://
AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001,thrivo://

# OAuth (optional until creds exist; a provider activates only when its pair is set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Monitoring (optional)
SENTRY_DSN=
# Deployed build identifier (git SHA). Injected by CI/Coolify at build time;
# tags Sentry releases and is surfaced by /health. Leave blank locally.
GIT_SHA=

# Transactional email (Resend). Optional until A2/A5 — without a key the send
# path degrades (logs + records email_logs) instead of delivering.
RESEND_API_KEY=
EMAIL_FROM=Thrivo <noreply@thrivo.fit>

# --- Added in later phases (uncomment + set when their phase lands) ---
# REVENUECAT_WEBHOOK_SECRET=      # A5  — subscription webhooks
# STRIPE_SECRET_KEY=              # A5  — billing fallback
# EXPO_ACCESS_TOKEN=              # A2  — push delivery

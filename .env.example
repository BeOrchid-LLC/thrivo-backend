# Environment
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Database (required — server refuses to boot without it)
DATABASE_URL=postgresql://user:password@localhost:5432/thrivo

# Redis (required — backs caching and the BullMQ job queue)
REDIS_URL=redis://localhost:6379

# Security
JWT_SECRET=your-secret-key-min-32-characters-long-please

# Monitoring (optional)
SENTRY_DSN=

# --- Added in later phases (uncomment + set when their phase lands) ---
# RESEND_API_KEY=                 # A2/A5 — transactional email
# REVENUECAT_WEBHOOK_SECRET=      # A5  — subscription webhooks
# STRIPE_SECRET_KEY=              # A5  — billing fallback
# EXPO_ACCESS_TOKEN=              # A2  — push delivery

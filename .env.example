# Environment
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Database (required — server refuses to boot without it)
DATABASE_URL=postgresql://user:password@localhost:5432/thrivo

# Redis (required — backs caching and the BullMQ job queue)
REDIS_URL=redis://localhost:6379

# Auth secret — signs admin session JWTs (HS256, separate from user auth). Required, min 32 chars.
AUTH_SECRET=your-secret-key-min-32-characters-long-please
# Public base URL of the API. Prod: https://api.thrivo.fit
AUTH_BASE_URL=http://localhost:4000
# CORS allowlist (comma-separated first-party origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Clerk — BeOrchid Consumer app (mobile + public web). All three required.
# Keys from the Clerk dashboard → API Keys (Consumer application).
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
# Webhook signing secret: Clerk dashboard → Webhooks → /webhooks/clerk endpoint.
CLERK_WEBHOOK_SECRET=whsec_...

# Clerk — BeOrchid Admin app (all admin/dashboard surfaces). All three required.
# Separate Clerk application from the consumer app: email+password, allowlisted emails.
# Keys from the Clerk dashboard → API Keys (Admin application).
CLERK_ADMIN_SECRET_KEY=sk_test_...
CLERK_ADMIN_PUBLISHABLE_KEY=pk_test_...
# Webhook signing secret: Clerk dashboard → Webhooks → /webhooks/clerk-admin endpoint.
CLERK_ADMIN_WEBHOOK_SECRET=whsec_...

# Monitoring — OPTIONAL in every environment. Missing SENTRY_DSN disables
# reporting but never prevents the API or worker from starting.
SENTRY_DSN=
# Deployed build identifier (git SHA). Injected by CI/Coolify at build time;
# tags Sentry releases and is surfaced by /health. Leave blank locally.
GIT_SHA=

# AI "describe it" food estimate (Claude). REQUIRED in production; the estimate
# endpoint fails fast without a key (no silent fallback). Model defaults to the
# cost/latency fit; override only if you need higher quality.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
# AI estimate cache + per-client rate limit tunables (optional — defaults shown)
AI_ESTIMATE_CACHE_TTL_SECONDS=86400
AI_ESTIMATE_RATE_LIMIT_MAX=30
AI_ESTIMATE_RATE_LIMIT_MAX_FREE=5
AI_ESTIMATE_RATE_LIMIT_WINDOW_SECONDS=3600
AI_ESTIMATE_MAX_TOKENS=160

# Open Food Facts-backed text search — cache + per-client rate limit tunables
# (optional — defaults shown)
FOOD_SEARCH_CACHE_TTL_SECONDS=86400
FOOD_SEARCH_CACHE_MAX_KEYS=750
FOOD_SEARCH_RATE_LIMIT_MAX=120
FOOD_SEARCH_RATE_LIMIT_WINDOW_SECONDS=3600

# Barcode lookup per-client rate limit tunables (optional — defaults shown)
BARCODE_LOOKUP_RATE_LIMIT_MAX=120
BARCODE_LOOKUP_RATE_LIMIT_WINDOW_SECONDS=3600

# Transactional email (Resend). REQUIRED in production — OTP sign-in codes ride
# this; in dev without a key the send path degrades (logs + records email_logs).
RESEND_API_KEY=
EMAIL_FROM=Thrivo <noreply@thrivo.fit>
# Svix secret from the Resend webhook configured for /api/v1/webhooks/resend.
RESEND_WEBHOOK_SECRET=
# Public origin used for app links and unsubscribe confirmation pages.
PUBLIC_APP_URL=http://localhost:3001
# Separate JWS key for long-lived, disable-only email preference links (min 32 chars).
EMAIL_LINK_SECRET=
# JSON map of key id -> base64 32-byte AES key; keep old keys while rows use them.
EMAIL_OUTBOX_ACTIVE_KEY_ID=v1
EMAIL_OUTBOX_ENCRYPTION_KEYS={"v1":"REPLACE_WITH_BASE64_32_BYTE_KEY"}
# Emergency kill switch. Durable outbox rows remain pending while false.
EMAIL_SENDING_ENABLED=true
# Candidate selection and calculations run, but no weekly outbox rows are created.
WEEKLY_REVIEW_DRY_RUN=false

# Admin panel auth
# Comma-separated list of staff email addresses allowed to sign in via OTP.
# Empty = no one can sign in (safe default for envs without admin staff).
ADMIN_EMAILS=ops@beorchid.com
# Optional per-email RBAC: comma-separated email:role pairs, role in
# admin | support | read-only. Emails in ADMIN_EMAILS but not here default to
# admin. An email listed only here is granted access at that role. Invalid role
# or malformed entry refuses server boot. Example:
# ADMIN_ROLES=support@beorchid.com:support,viewer@beorchid.com:read-only
ADMIN_ROLES=
# httpOnly cookie lifetime for admin sessions (jose duration string, e.g. 8h, 1d)
ADMIN_SESSION_TTL=8h
# Public base URL of the admin SPA — used to build invite + password-reset links
# in emails. Never built from user input. Dev default matches the admin dev port.
ADMIN_APP_URL=http://localhost:3000
# One-time seed password for the super admin (subscriptions@beorchid.com).
# Optional (dev/CI boot without it). Set in Coolify for the initial run; change
# on first login. Never commit the literal.
SUPER_ADMIN_INITIAL_PASSWORD=

# RevenueCat webhook shared secret — the exact Authorization header value you set
# in the RevenueCat dashboard. REQUIRED in production. The webhook drives
# entitlement (source of truth); unset = every webhook is rejected (fail closed).
REVENUECAT_WEBHOOK_AUTH=
BILLING_PROVIDER=disabled
# Set true only on the isolated staging backend paired with RevenueCat Test Store.
REVENUECAT_ALLOW_TEST_STORE=false
REVENUECAT_SECRET_API_KEY=
REVENUECAT_ENTITLEMENT_ID=
REVENUECAT_PRODUCT_CATALOG={}
REVENUECAT_LEGACY_MUTATIONS=disabled

# Expo push access token (optional) — raises push rate limits / enables enhanced
# security. The daily nudge sends tokenless when this is unset.
EXPO_ACCESS_TOKEN=
# New admin operational workflows are disabled by default. Before the first
# Thrivo release, configure the internal test users' email addresses and enable
# these four flags together in the same deployment; no gradual rollout is
# required for the unreleased product.
ADMIN_PUSH_TEST_USER_EMAILS=
ADMIN_PUSH_TEST_ENABLED=false
ADMIN_PUSH_LIFECYCLE_ENABLED=false
ADMIN_EMAIL_RESEND_ENABLED=false
ADMIN_LEAD_CONTACT_ENABLED=false

# Cloudflare R2 object storage (optional). The four core credentials are
# all-or-nothing — set all or none. Unset = uploads (profile avatars, future
# progress/meal photos) fail at point-of-use; the server still boots. Clients
# upload directly to R2 via short-lived presigned URLs.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Key prefix namespacing every object (lets one bucket serve multiple envs)
R2_FOLDER_PREFIX=staging-files
# Public read URLs. Set at least one when R2 is configured: CDN_URL (custom
# domain) takes precedence, PUBLIC_URL (e.g. https://<bucket>.r2.dev) is fallback.
R2_CDN_URL=
R2_PUBLIC_URL=

# --- Added in later phases (uncomment + set when their phase lands) ---
# STRIPE_SECRET_KEY=              # A5  — billing fallback

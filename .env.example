# Environment
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Database (required — server refuses to boot without it)
DATABASE_URL=postgresql://user:password@localhost:5432/thrivo

# Redis (required — backs caching and the BullMQ job queue)
REDIS_URL=redis://localhost:6379

# Auth (required — signs access JWTs, HS256; min 32 chars). The legacy
# BETTER_AUTH_SECRET name is still accepted as a fallback for existing deploys.
AUTH_SECRET=your-secret-key-min-32-characters-long-please
# Hand-rolled auth token lifetimes (optional — sane defaults shown)
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# Deep link the OAuth callback returns to with the issued tokens (app parses it)
APP_AUTH_REDIRECT_URL=thrivo://auth
# Public base URL of the API. The Google OAuth redirect URI is derived from this
# as <AUTH_BASE_URL>/api/v1/auth/google/callback — register THAT in the Google
# console. Prod: https://api.thrivo.fit
AUTH_BASE_URL=http://localhost:4000
# CORS allowlist (comma-separated first-party origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# OAuth (optional until creds exist; Google activates only when its pair is set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Monitoring — REQUIRED in production (crash/error visibility); optional in dev
SENTRY_DSN=
# Deployed build identifier (git SHA). Injected by CI/Coolify at build time;
# tags Sentry releases and is surfaced by /health. Leave blank locally.
GIT_SHA=

# AI "describe it" food estimate (Claude). REQUIRED in production; the estimate
# endpoint fails fast without a key (no silent fallback). Model defaults to the
# cost/latency fit; override only if you need higher quality.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Transactional email (Resend). REQUIRED in production — OTP sign-in codes ride
# this; in dev without a key the send path degrades (logs + records email_logs).
RESEND_API_KEY=
EMAIL_FROM=Thrivo <noreply@thrivo.fit>

# Admin panel auth
# Comma-separated list of staff email addresses allowed to sign in via OTP.
# Empty = no one can sign in (safe default for envs without admin staff).
ADMIN_EMAILS=ops@beorchid.com
# httpOnly cookie lifetime for admin sessions (jose duration string, e.g. 8h, 1d)
ADMIN_SESSION_TTL=8h

# RevenueCat webhook shared secret — the exact Authorization header value you set
# in the RevenueCat dashboard. REQUIRED in production. The webhook drives
# entitlement (source of truth); unset = every webhook is rejected (fail closed).
REVENUECAT_WEBHOOK_AUTH=

# Expo push access token (optional) — raises push rate limits / enables enhanced
# security. The daily nudge sends tokenless when this is unset.
EXPO_ACCESS_TOKEN=

# --- Added in later phases (uncomment + set when their phase lands) ---
# STRIPE_SECRET_KEY=              # A5  — billing fallback

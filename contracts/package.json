{
  "name": "@beorchid-llc/thrivo-contracts",
  "version": "0.15.2",
  "description": "Shared Thrivo API request and response contracts.",
  "type": "module",
  "private": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./common": {
      "types": "./dist/common.d.ts",
      "import": "./dist/common.js"
    },
    "./users": {
      "types": "./dist/users.d.ts",
      "import": "./dist/users.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "import": "./dist/auth.js"
    },
    "./admin": {
      "types": "./dist/admin.d.ts",
      "import": "./dist/admin.js"
    },
    "./dashboard": {
      "types": "./dist/dashboard.d.ts",
      "import": "./dist/dashboard.js"
    },
    "./foods": {
      "types": "./dist/foods.d.ts",
      "import": "./dist/foods.js"
    },
    "./metrics": {
      "types": "./dist/metrics.d.ts",
      "import": "./dist/metrics.js"
    },
    "./settings": {
      "types": "./dist/settings.d.ts",
      "import": "./dist/settings.js"
    },
    "./subscriptions": {
      "types": "./dist/subscriptions.d.ts",
      "import": "./dist/subscriptions.js"
    },
    "./uploads": {
      "types": "./dist/uploads.d.ts",
      "import": "./dist/uploads.js"
    },
    "./tdee": {
      "types": "./dist/tdee.d.ts",
      "import": "./dist/tdee.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "zod": "^3.24.0",
    "typescript": "^5.6.0"
  },
  "scripts": {
    "prepack": "npm run build",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pack:dry": "npm pack --dry-run"
  }
}

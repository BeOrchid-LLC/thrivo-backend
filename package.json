{
  "name": "thrivo-backend",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/src/index.js",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:integration": "vitest run --grep integration",
    "test:watch": "vitest --watch",
    "worker": "tsx watch src/jobs/worker.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx db/seed.ts",
    "lint": "eslint src db --ext .ts",
    "format": "prettier --write \"src/**/*.ts\" \"db/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"db/**/*.ts\"",
    "checks": "npm run lint && npm run format:check && npm run build"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "@hono/node-server": "^1.13.0",
    "zod": "^3.24.0",
    "drizzle-orm": "^0.33.0",
    "pg": "^8.12.0",
    "ioredis": "^5.4.1",
    "bullmq": "^5.13.0",
    "uuidv7": "^1.0.2",
    "pino": "^9.4.0",
    "@sentry/node": "^8.32.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/pg": "^8.12.0",
    "typescript": "^5.6.0",
    "tsx": "^4.19.0",
    "vitest": "^2.1.0",
    "eslint": "^9.11.0",
    "@eslint/js": "^9.11.0",
    "typescript-eslint": "^8.4.0",
    "eslint-config-prettier": "^9.1.0",
    "pino-pretty": "^11.2.2",
    "prettier": "^3.3.0",
    "drizzle-kit": "^0.24.0"
  }
}

{
  "name": "thrivo-backend",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "test": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "contracts:build": "tsc -p contracts/tsconfig.json",
    "contracts:typecheck": "tsc -p contracts/tsconfig.json --noEmit",
    "contracts:pack:dry": "npm pack ./contracts --dry-run",
    "worker": "tsx watch src/jobs/worker.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx db/migrate.ts",
    "db:migrate:deploy": "node dist/migrate.js",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx db/seed.ts",
    "db:check-timestamps": "tsx scripts/check-schema-timestamps.ts",
    "check:env-example": "tsx scripts/check-env-example.ts",
    "backfill:food-basis": "tsx scripts/backfill-food-basis.ts",
    "backfill:food-basis:deploy": "node dist/backfill-food-basis.js",
    "backfill:streaks": "tsx scripts/backfill-streaks.ts",
    "backfill:streaks:deploy": "node dist/backfill-streaks.js",
    "backfill:mrr-snapshots": "tsx scripts/backfill-mrr-snapshots.ts",
    "backfill:mrr-snapshots:deploy": "node dist/backfill-mrr-snapshots.js",
    "backfill:subscription-event-prices": "tsx scripts/backfill-subscription-event-prices.ts",
    "backfill:subscription-event-prices:deploy": "node dist/backfill-subscription-event-prices.js",
    "lint": "eslint src db contracts/src tests --ext .ts",
    "format": "prettier --write \"src/**/*.ts\" \"db/**/*.ts\" \"contracts/src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"db/**/*.ts\" \"contracts/src/**/*.ts\" \"tests/**/*.ts\"",
    "checks": "npm run lint && npm run format:check && npm run typecheck && npm run contracts:typecheck && npm run db:check-timestamps && npm run check:env-example"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.106.0",
    "@aws-sdk/client-s3": "^3.1075.0",
    "@aws-sdk/s3-request-presigner": "^3.1075.0",
    "@hono/node-server": "^1.13.0",
    "@hono/zod-validator": "^0.4.1",
    "@sentry/node": "^8.32.0",
    "bullmq": "^5.13.0",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.6.0",
    "ioredis": "^5.4.1",
    "jose": "^6.2.3",
    "nanoid": "^5.1.16",
    "pg": "^8.12.0",
    "pino": "^9.4.0",
    "ua-parser-js": "^2.0.10",
    "uuidv7": "^1.0.2",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.0",
    "@types/node": "^22.5.0",
    "@types/pg": "^8.12.0",
    "@vitest/coverage-v8": "^2.1.0",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.11.0",
    "eslint-config-prettier": "^9.1.0",
    "pino-pretty": "^11.2.2",
    "prettier": "^3.3.0",
    "tsup": "^8.2.4",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.4.0",
    "vitest": "^2.1.0"
  }
}

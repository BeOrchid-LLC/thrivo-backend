{
  "name": "thrivo-backend",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:integration": "vitest run --grep integration",
    "test:watch": "vitest --watch",
    "lint": "eslint src db --ext .ts",
    "format": "prettier --write 'src/**/*.ts' 'db/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' 'db/**/*.ts'",
    "checks": "npm run lint && npm run format:check && npm run build"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "zod": "^3.24.0",
    "drizzle-orm": "^0.33.0",
    "pg": "^8.12.0",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0",
    "@sentry/node": "^8.32.0",
    "@sentry/tracing": "^8.32.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/pg": "^8.12.0",
    "typescript": "^5.6.0",
    "tsx": "^4.19.0",
    "vitest": "^2.1.0",
    "eslint": "^9.11.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.0",
    "@typescript-eslint/eslint-plugin": "^8.4.0",
    "@typescript-eslint/parser": "^8.4.0",
    "drizzle-kit": "^0.24.0"
  }
}

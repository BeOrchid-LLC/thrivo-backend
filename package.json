{
  "name": "thrivo-backend",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:integration": "vitest run --grep integration",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "worker": "tsx watch src/jobs/worker.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx db/migrate.ts",
    "db:migrate:deploy": "node dist/migrate.js",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx db/seed.ts",
    "lint": "eslint src db --ext .ts",
    "format": "prettier --write \"src/**/*.ts\" \"db/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"db/**/*.ts\"",
    "checks": "npm run lint && npm run format:check && npm run typecheck"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@hono/zod-validator": "^0.4.1",
    "@sentry/node": "^8.32.0",
    "better-auth": "^1.6.16",
    "bullmq": "^5.13.0",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.6.0",
    "ioredis": "^5.4.1",
    "pg": "^8.12.0",
    "pino": "^9.4.0",
    "uuidv7": "^1.0.2",
    "zod": "^3.24.0"
  },
  "overrides": {
    "@better-auth/core": "^1.6.18"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.21",
    "@eslint/js": "^9.11.0",
    "@types/node": "^22.5.0",
    "@types/pg": "^8.12.0",
    "@vitest/coverage-v8": "^2.1.0",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.11.0",
    "eslint-config-prettier": "^9.1.0",
    "pino-pretty": "^11.2.2",
    "prettier": "^3.3.0",
    "tsup": "^8.2.4",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.4.0",
    "vitest": "^2.1.0"
  }
}
